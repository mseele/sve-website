---
import Event from '@/components/blocks/Event.astro'
import type { GetStaticPaths } from 'astro'
import { getCollection, type CollectionEntry } from 'astro:content'

export const getStaticPaths: GetStaticPaths = async () => {
  const collection = await getCollection('fitness')
  if (!collection) return []
  const sorted = collection.sort((a, b) => a.data.sortIndex - b.data.sortIndex)
  const wrap = sorted.length > 1
  return sorted.map((entry, index) => ({
    params: {
      id: entry.data.id,
    },
    props: {
      entry,
      siblings: {
        prev: index > 0 ? sorted[index - 1] : wrap ? sorted[sorted.length - 1] : null,
        next: index < sorted.length - 1 ? sorted[index + 1] : wrap ? sorted[0] : null,
        position: index + 1,
        total: sorted.length,
      },
    },
  }))
}

interface Props {
  entry: CollectionEntry<'fitness'>
  siblings: {
    prev: CollectionEntry<'fitness'> | null
    next: CollectionEntry<'fitness'> | null
    position: number
    total: number
  }
}

const { entry, siblings } = Astro.props
---

<Event
  type="fitness"
  entry={entry}
  siblings={siblings}
  newsletterDescription="Erhalte automatisch eine E-Mail sobald neue Kursangebote online sind."
  newsletterText="Ich möchte über zukünftige Kurse per E-Mail informiert werden"
  schemaType="SportsEvent"
/>