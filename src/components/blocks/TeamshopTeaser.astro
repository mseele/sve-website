---
import Button from '@/components/controls/Button.astro'
import Container from '@/components/common/Container.astro'
import { TEAMSHOP_URL } from '@/data/links'
---

<section id="teamshop" class="pt-10">
  <Container>
    <div class="relative">
      <div
        aria-hidden="true"
        class="to-primary absolute inset-0 my-auto h-32 w-96 translate-y-24 rotate-45 bg-linear-to-r from-red-200 opacity-50 blur-3xl sm:h-52 sm:translate-y-0 lg:hidden dark:from-red-700"
      >
      </div>
      <div class="relative space-y-3 py-10 text-center">
        <p class="text-primary text-sm font-semibold tracking-widest uppercase dark:text-red-500">
          SVE Teamshop
        </p>
        <h2 class="text-3xl font-bold text-gray-900 md:text-4xl lg:text-5xl dark:text-white">
          Zeig Deine <span class="text-primary dark:text-red-500">Farben</span>
        </h2>
        <p class="mx-auto max-w-xl text-gray-600 dark:text-gray-300">
          Trikots, Hoodies, Jacken und mehr – alle JAKO-Artikel mit SV Eutingen Veredelung.
          Bestelle direkt im offiziellen Teamshop.
        </p>
        <div class="flex justify-center pt-6">
          <Button emphasis="primary" href={TEAMSHOP_URL} target="_blank" rel="noreferrer">
            Zum Teamshop
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>
